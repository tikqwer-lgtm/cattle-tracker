# Copy to .env and set ONE of the options below for the chat consultant.
#
# Option 1 — FREE, local (no payment): Ollama
# Install from https://ollama.com , then: ollama run llama3.2
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
#
# Option 2 — Cloud (may require payment): DeepSeek
# Get key at https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-your-key-here
#
# Чат-консультант (опционально):
# CHAT_DOCS_MAX_CHARS=8000
# CHAT_REQUEST_TIMEOUT_MS=180000
# CHAT_OLLAMA_MAX_TOKENS=512
# CHAT_TEMPERATURE=0.2
#
# Каталог для загружаемых APK (абсолютный путь). По умолчанию — папка apk/ рядом с server.js.
# Удобно для хранения на другом сервере: смонтируйте его каталог сюда (NFS, SSHFS, сетевой диск)
# и укажите путь, например:
# APK_STORAGE_DIR=/var/lib/cattle-tracker-apk
#
# Битрикс24: входящий webhook (полный URL). Можно также задать в UI «Синхронизация» (admin).
# Не коммитьте реальный ключ в git.
# BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxx/