# Скопируйте в mobile-installer.env и заполните (файл mobile-installer.env в .gitignore).
# Для Cursor Automation те же имена задайте в Secrets облачной среды
# (cursor.com/dashboard/cloud-agents) — в git их класть нельзя.
# База API без суффикса /api:
CATTLE_TRACKER_API_BASE=http://127.0.0.1:3000

# Вариант A: готовый JWT администратора
# CATTLE_TRACKER_APK_UPLOAD_TOKEN=

# Вариант B: логин/пароль учётки приложения с ролью admin (экран «Войти»)
CATTLE_TRACKER_APK_UPLOAD_USER=
CATTLE_TRACKER_APK_UPLOAD_PASSWORD=
